      <plugin name="gazebo_ros_bumper_controller" filename="libgazebo_ros_bumper.so">   
          <bumperTopicName>feet_bumpers</bumperTopicName>
          <frameName>world</frameName>
      </plugin>
  </sensor>
  </gazebo>
  <gazebo reference="left_back_shoulder_link">
    <xacro:leg_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
    <sensor name="left_back_kneecap" type="contact">
      <selfCollide>false</selfCollide>
      <alwaysOn>true</alwaysOn>
      <updateRate>1.0</updateRate>
      <material>Gazebo/Red</material>
