<?xml version="1.0" ?>
<robot name="bittle" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<gazebo>
  <plugin name="control" filename="libgazebo_ros_control.so"/>
</gazebo>

<xacro:macro name="green_body">
  <visual>
    <material>
      <ambient>0 0.752941176470588 0 1</ambient>
      <diffuse>0 0.752941176470588 0 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <emissive>0 0 0 0</emissive>
    </material>
  </visual>
</xacro:macro>

<xacro:macro name="leg_color">
  <visual>
    <material>
      <ambient>0.501960784313725 1 0.501960784313725 1</ambient>
      <diffuse>0.501960784313725 1 0.501960784313725 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <emissive>0 0 0 0</emissive>
    </material>
  </visual>
</xacro:macro>

<xacro:macro name="shin_color">
  <visual>
    <material>
      <ambient>0 0 0 1</ambient>
      <diffuse>0 0 0 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <emissive>0 0 0 0</emissive>
    </material>
  </visual>
</xacro:macro>



  <gazebo reference="base_frame_link">
    <xacro:green_body />
  </gazebo>
  
  <gazebo reference="right_front_shoulder_link">
    <xacro:leg_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>
  <gazebo reference="right_front_knee_link">
    <xacro:shin_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>
  <gazebo reference="right_back_shoulder_link">
    <xacro:leg_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>
  <gazebo reference="right_back_knee_link">
    <xacro:shin_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>


  <gazebo reference="left_front_shoulder_link">
    <xacro:leg_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>
  <gazebo reference="left_front_knee_link">
    <xacro:shin_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>
  <gazebo reference="left_back_shoulder_link">
    <xacro:leg_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>
  <gazebo reference="left_back_knee_link">
    <xacro:shin_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
  </gazebo>

  

</robot>
