          <bumperTopicName>knee_bumpers</bumperTopicName>
          <frameName>world</frameName>
      </plugin>
  </sensor>
  </gazebo>
  <gazebo reference="left_front_knee_link">
    <xacro:shin_color />
    <mu1>100.0</mu1>        <mu2>100.0</mu2>        <kp>10000000.0</kp>     <kd>1000.0</kd>         <maxVel>0.01</maxVel>   <minDepth>0.00</minDepth>
    <sensor name="left_front_foot" type="contact">
      <selfCollide>false</selfCollide>
      <alwaysOn>true</alwaysOn>
      <updateRate>1.0</updateRate>
      <material>Gazebo/Red</material>
      <contact>
